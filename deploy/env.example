# Copy to deploy/.env on the server; these values contain no passwords.
PANEL_IMAGE_TAG=local
PANEL_PORT=8080
# Keep false when accessing the panel over an SSH tunnel at http://127.0.0.1.
# Set true only when the browser connects through an HTTPS reverse proxy.
PANEL_COOKIE_SECURE=false
# Optional comma-separated hostnames if an HTTPS reverse proxy is added later.
# Loopback hosts (localhost, 127.0.0.1, ::1) are always accepted.
PANEL_ALLOWED_HOSTS=

TT_PUBLIC_ADDRESS=dman.pancom.pw:443
TT_BIND_IP=0.0.0.0
TT_PORT=443
