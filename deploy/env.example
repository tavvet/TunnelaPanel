# Copy to deploy/.env on the server; these values contain no passwords.
PANEL_IMAGE_TAG=local
PANEL_PORT=8080
# Keep false when accessing the panel over an SSH tunnel at http://127.0.0.1.
# Set true only when the browser connects through an HTTPS reverse proxy.
PANEL_COOKIE_SECURE=false
# Optional comma-separated hostnames if an HTTPS reverse proxy is added later.
# Loopback hosts (localhost, 127.0.0.1, ::1) are always accepted.
PANEL_ALLOWED_HOSTS=
# Only explicitly trusted proxy IPs/CIDRs may supply X-Real-IP.
PANEL_TRUSTED_PROXIES=

# To enable https://dman.pancom.pw:8443, set these above:
# PANEL_COOKIE_SECURE=true
# PANEL_ALLOWED_HOSTS=dman.pancom.pw
# PANEL_TRUSTED_PROXIES=172.30.80.3
# Then enable the optional HTTPS service:
# COMPOSE_PROFILES=https
PANEL_HTTPS_BIND_IP=0.0.0.0
PANEL_HTTPS_PORT=8443
# Must not overlap other Docker/VPN networks. For concurrent staging use a
# separate subnet/IP, and keep PANEL_TRUSTED_PROXIES in sync with PANEL_PROXY_IP.
PANEL_PROXY_SUBNET=172.30.80.0/29
PANEL_PROXY_IP=172.30.80.3

TT_PUBLIC_ADDRESS=dman.pancom.pw:443
TT_BIND_IP=0.0.0.0
TT_PORT=443
